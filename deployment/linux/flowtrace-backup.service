[Unit]
Description=FlowTrace consistent database and attachment backup
After=postgresql@17-main.service
Requires=postgresql@17-main.service

[Service]
Type=oneshot
User=flowtrace
Group=flowtrace
WorkingDirectory=/opt/flowtrace/current
EnvironmentFile=/etc/flowtrace/server.env
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/flowtrace
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=300
MemoryMax=768M
CPUQuota=100%
ExecStart=/opt/flowtrace/current/.venv/bin/python -m flowtrace_server.backups.cli create --pg-dump /usr/lib/postgresql/17/bin/pg_dump
