# Copy to .env and use independently generated credentials. This file is never loaded automatically.
FLOWTRACE_ENVIRONMENT=development
FLOWTRACE_DATABASE_URL=postgresql+psycopg://flowtrace:replace-this-password@127.0.0.1:5432/flowtrace
FLOWTRACE_DATABASE_CONNECT_TIMEOUT=3
FLOWTRACE_LOG_LEVEL=INFO
FLOWTRACE_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
FLOWTRACE_CORS_ORIGINS=[]
FLOWTRACE_DATA_DIRECTORY=./var
FLOWTRACE_DIAGNOSTICS_ENABLED=true
