  "cases": [
    {
      "id": "SYN01",
      "name": "lost_response_retry",
      "steps": [
        "push create commits; discard response",
        "retry identical operation_id and body"
      ],
      "expected": {
        "bill_count": 1,
        "same_receipt": true
      }
    },
    {
      "id": "SYN02",
      "name": "same_id_different_body",
      "steps": [
        "push create commits",
        "retry same id with amount_minor 1240"
      ],
      "expected": {
        "code": "idempotency_mismatch",
        "http_status": 409,
        "bill_count": 1
      }
    },
    {
      "id": "SYN03",
      "name": "edit_edit",
      "steps": [
        "device A and B read revision 1",
        "A updates base_revision 1 => revision 2",
        "B updates base_revision 1"
      ],
      "expected": {
        "code": "revision_conflict",
        "server_revision": "2",
        "local_draft_preserved": true
      }
    },
    {
      "id": "SYN04",
      "name": "edit_delete",
      "steps": [
        "A deletes revision 1",
        "B edits base_revision 1"
      ],
      "expected": {
        "code": "revision_conflict",
        "resurrection": false
      }
    },
    {
      "id": "SYN05",
      "name": "commit_order",
      "steps": [
