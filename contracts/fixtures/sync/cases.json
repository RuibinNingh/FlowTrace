        "B requests scope lock and waits",
        "pull sees committed highwater 40",
        "A commits then B allocates/commits 42",
        "pull after 40"
      ],
      "expected": {
        "revisions": [
          "41",
          "42"
        ],
        "missing": []
      }
    },
    {
